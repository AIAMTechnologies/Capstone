# Copy this file to `.env` and fill in the values for local development
DATABASE_URL=postgresql://postgres:password@localhost:5432/capstone
SECRET_KEY=replace-with-a-long-random-string
ML_PUBLIC_API_KEY=local-ml-api-key
# Optional: add any other environment variables you need
LASSO_BASE_URL=https://lap.conveniencegroup.com
LASSO_USERNAME=
LASSO_PASSWORD=
LASSO_PAGE_LIMIT=1000
LASSO_UNASSIGNED_PAGE_LIMIT=1000
LASSO_ACTIVE_PAGE_LIMIT=1000
LASSO_HISTORY_PAGE_LIMIT=250
LASSO_TIMEOUT_CONNECT_SECONDS=15
LASSO_TIMEOUT_READ_SECONDS=180
LASSO_REQUEST_RETRIES=2
AZURE_OPENAI_ENABLED=false
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT_GPT_4_1_NANO=
AZURE_OPENAI_DEPLOYMENT_GPT_4_1_MINI=
AZURE_OPENAI_DEPLOYMENT_GPT_4_1=
AZURE_OPENAI_DEPLOYMENT_GPT_4O_MINI=
